{
  "manifest_version": 3,
  "name": "Transcritor de Chamadas",
  "version": "0.6.0",
  "description": "Transcreve as chamadas do Google Meet pelas legendas, com o nome de quem falou, e tem um copiloto de vendas e uma agenda das calls.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Transcritor de Chamadas",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "lib/falas.js",
        "meet/seletores.js",
        "meet/meet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "copiloto/painel.html"
  }
}
