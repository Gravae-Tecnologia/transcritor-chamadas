# /etc/gravae-copiloto.env na VM coaching-tools (dono root, modo 600). Os valores
# de verdade ficam só lá: a chave é a mesma da VictorIA; o SendGrid e o cliente
# Google são os do bolão.
OPENROUTER_API_KEY=
# O login: código por e-mail (SendGrid).
SENDGRID_API_KEY=
EMAIL_FROM=noreply@gravae.io
# Login Google (opcional; precisa de BASE_URL/callback cadastrado no cliente OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Segredo das sessões (openssl rand -hex 32). Trocar desloga todo mundo.
SEGREDO=
BASE_URL=https://intake.gravae.io/copiloto
DOMINIO=gravae.io
# IDs das extensões que podem pedir login (o da extensão vem da "key" do manifest).
EXTENSOES=
LIMITE_DIA_USD=3
ROTEIRO=/opt/gravae-copiloto/roteiro.json
